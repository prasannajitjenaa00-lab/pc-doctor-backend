# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pc_doctor?retryWrites=true&w=majority

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Optional Cloudinary (leave empty for local disk fallback in uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
