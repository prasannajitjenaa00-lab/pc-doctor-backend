# ==============================================================================
# PC Doctor - Nginx Configuration Template for Hostinger VPS (Ubuntu/Debian)
# Place this file in: /etc/nginx/sites-available/pc-doctor
# Then link it to:    /etc/nginx/sites-enabled/pc-doctor
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    
    # Replace with your domain name or VPS public IP
    server_name yourdomain.com www.yourdomain.com;

    # Maximum upload size for device condition photos and shop logos
    client_max_body_size 25M;

    # Gzip compression for high performance
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # --------------------------------------------------------------------------
    # 1. React SPA Frontend Static Files
    # --------------------------------------------------------------------------
    location / {
        root /var/www/pc-doctor/client/dist;
        index index.html;
        # Support React Router HTML5 History Mode
        try_files $uri $uri/ /index.html;

        # Cache static bundle assets (hashed JS, CSS, images)
        location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|webp)$ {
            expires 1y;
            add_header Cache-Control "public, max-age=31536000, immutable";
            access_log off;
        }
    }

    # --------------------------------------------------------------------------
    # 2. Node.js Express Backend API Proxy
    # --------------------------------------------------------------------------
    location /api {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }

    # --------------------------------------------------------------------------
    # 3. Direct Static Serving for Uploaded Photos and Shop Logos
    # --------------------------------------------------------------------------
    location /uploads {
        alias /var/www/pc-doctor/server/uploads;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # --------------------------------------------------------------------------
    # 4. Security Headers
    # --------------------------------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
}
